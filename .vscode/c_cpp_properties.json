{
    "configurations": [
        {
            "name": "ESZ-OS",
            "includePath": [
                "${workspaceFolder}/kernel/**"
            ],
            "compilerPath": "/opt/homebrew/bin/x86_64-elf-g++",
            "compilerArgs": [
                "-m64",
                "-march=x86-64",
                "-mcmodel=kernel",
                "-mno-red-zone",
                "-ffreestanding",
                "-fno-exceptions",
                "-fno-rtti"
            ],
            "defines": [
                "__x86_64__",
                "__KERNEL__"
            ],
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "linux-gcc-x64",
            "browse": {
                "path": [
                    "${workspaceFolder}/kernel"
                ],
                "limitSymbolsToIncludedHeaders": false
            }
        },
        {
            "name": "ESZ-OS Tests",
            "compileCommands": "${workspaceFolder}/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/tests/vendor",
                "${workspaceFolder}/tests/support"
            ],
            "compilerPath": "/usr/bin/c++",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "macos-clang-arm64",
            "browse": {
                "path": [
                    "${workspaceFolder}/kernel",
                    "${workspaceFolder}/tests"
                ],
                "limitSymbolsToIncludedHeaders": false
            }
        }
    ],
    "version": 4
}
